# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Databricks (needed only for deploy.py) ---
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>

# Unity Catalog name for the model: <catalog>.<schema>.<model>
UC_MODEL_NAME=main.default.langchain_docs_agent

# Databricks secret holding the OpenAI key (the endpoint reads it at runtime)
# databricks secrets create-scope openai && databricks secrets put-secret openai api_key
DATABRICKS_SECRET_SCOPE=openai
DATABRICKS_SECRET_KEY=api_key
